# --- Conexión a GLPI (mesadeayuda.gob.pe) ---

# URL base de la API REST de GLPI. Normalmente termina en /apirest.php
GLPI_API_URL=https://mesadeayuda.gob.pe/apirest.php

# App-Token: Configuración > General > pestaña "API" > editar el acceso API
# ("Full access API" o el que uses) > "Generar" en App-Token.
GLPI_APP_TOKEN=

# User-Token del usuario superadmin: Preferencias (ícono de usuario, arriba a
# la derecha) > pestaña "Configuración remota de acceso" / "API" > "Generar"
# en Token de acceso personal.
GLPI_USER_TOKEN=

# Alternativa a GLPI_USER_TOKEN: autenticación por usuario/contraseña.
# Solo se usa si GLPI_USER_TOKEN está vacío. No recomendado en producción.
# GLPI_BASIC_USER=
# GLPI_BASIC_PASSWORD=

# Verificación TLS del certificado de mesadeayuda.gob.pe (dejar en true salvo
# que estés en un entorno de pruebas con certificado autofirmado)
GLPI_TLS_REJECT_UNAUTHORIZED=true

# --- IDs de search options de GLPI para el itemtype Ticket ---
# Estos IDs son los valores por defecto de una instalación estándar de GLPI
# 10.x, pero pueden variar si la UTI del PAE personalizó el formulario de
# tickets o instaló plugins. Verifícalos en tu instancia (ver README, sección
# "Verificar los IDs de campos") y ajústalos aquí si no coinciden.
GLPI_SO_STATUS=12
GLPI_SO_CATEGORY=7
GLPI_SO_TECHNICIAN=5
GLPI_SO_GROUP=8
GLPI_SO_PRIORITY=3
GLPI_SO_DATE_OPENED=15
GLPI_SO_DATE_CLOSED=16
GLPI_SO_TIME_TO_RESOLVE=18
GLPI_SO_SOLVEDATE=17

# --- Servidor ---
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Acceso al dashboard (protección básica, opcional pero recomendada) ---
# Si se definen, el backend exige HTTP Basic Auth en todas las rutas /api/*
DASHBOARD_USER=
DASHBOARD_PASSWORD=
